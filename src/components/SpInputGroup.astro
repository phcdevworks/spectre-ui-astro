---
import type { InputGroupRecipeOptions } from "@phcdevworks/spectre-ui";
import { getInputGroupClasses } from "@phcdevworks/spectre-ui";
import { omitUndefined } from "./sp-recipe-options.shared";

interface SpInputGroupProps extends InputGroupRecipeOptions {
  class?: string;
  id?: string;
  "aria-label"?: string;
  "aria-labelledby"?: string;

  [key: string]: unknown;
}

const {
  disabled,
  class: className,
  id,
  "aria-label": ariaLabel,
  "aria-labelledby": ariaLabelledby,
  ...rest
} = Astro.props as SpInputGroupProps;

const classes = getInputGroupClasses(omitUndefined({ disabled }));
const finalClass = [classes, className].filter(Boolean).join(" ");
---

<div
  class={finalClass}
  id={id}
  role="group"
  aria-label={ariaLabel}
  aria-labelledby={ariaLabelledby}
  aria-disabled={disabled ? "true" : undefined}
  {...rest}
>
  <slot />
</div>
