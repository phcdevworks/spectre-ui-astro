---
import { getDropdownHeaderClasses } from "@phcdevworks/spectre-ui";

type SpDropdownHeaderElement = "div" | "li" | "span" | "h2" | "h3" | "h4" | "h5" | "h6";

interface SpDropdownHeaderProps {
  as?: SpDropdownHeaderElement;
  class?: string;
  id?: string;

  [key: string]: unknown;
}

const {
  as: Tag = "div",
  class: className,
  id,
  ...rest
} = Astro.props as SpDropdownHeaderProps;

const finalClass = [getDropdownHeaderClasses(), className].filter(Boolean).join(" ");
---

<Tag class={finalClass} id={id} {...rest}>
  <slot />
</Tag>
