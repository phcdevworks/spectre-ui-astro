---
import type { TextRecipeOptions } from "@phcdevworks/spectre-ui";
import { getTextClasses } from "@phcdevworks/spectre-ui";
import { omitUndefined } from "./sp-recipe-options.shared";

type SpTextElement = "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p" | "span";

interface SpTextProps extends TextRecipeOptions {
  as?: SpTextElement;
  class?: string;
  id?: string;
  "aria-label"?: string;
  "aria-describedby"?: string;

  [key: string]: unknown;
}

const {
  as: Tag = "p",
  size,
  variant,
  family,
  transform,
  class: className,
  id,
  "aria-label": ariaLabel,
  "aria-describedby": ariaDescribedby,
  ...rest
} = Astro.props as SpTextProps;

const classes = getTextClasses(omitUndefined({ size, variant, family, transform }));
const finalClass = [classes, className].filter(Boolean).join(" ");
---

<Tag
  class={finalClass}
  id={id}
  aria-label={ariaLabel}
  aria-describedby={ariaDescribedby}
  {...rest}
>
  <slot />
</Tag>
