---
import type { ProseRecipeOptions } from "@phcdevworks/spectre-ui";
import { getProseClasses } from "@phcdevworks/spectre-ui";
import { omitUndefined } from "./sp-recipe-options.shared";

type SpProseElement = "div" | "article" | "section" | "main" | "aside";

interface SpProseProps extends ProseRecipeOptions {
  as?: SpProseElement;
  class?: string;
  id?: string;
  "aria-label"?: string;

  [key: string]: unknown;
}

const {
  accentMarkers,
  as: Tag = "div",
  class: className,
  id,
  "aria-label": ariaLabel,
  ...rest
} = Astro.props as SpProseProps;

const finalClass = [getProseClasses(omitUndefined({ accentMarkers })), className].filter(Boolean).join(" ");
---

<Tag class={finalClass} id={id} aria-label={ariaLabel} {...rest}>
  <slot />
</Tag>
