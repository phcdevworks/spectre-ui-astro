---
import type { DropdownAccentColor, DropdownAccentEdge, DropdownPlacement } from "@phcdevworks/spectre-ui";
import { getDropdownClasses, getDropdownMenuClasses, getNavLinkClasses } from "@phcdevworks/spectre-ui";
import { omitUndefined } from "./sp-recipe-options.shared";

interface SpNavItemProps {
  dropdown?: boolean;
  href?: string;
  label?: string;
  open?: boolean;
  active?: boolean;
  disabled?: boolean;
  hovered?: boolean;
  focused?: boolean;
  placement?: DropdownPlacement;
  fullWidth?: boolean;
  mega?: boolean;
  viewport?: boolean;
  accent?: DropdownAccentEdge;
  accentColor?: DropdownAccentColor;
  class?: string;
  id?: string;
  title?: string;
  "aria-label"?: string;

  [key: string]: unknown;
}

const {
  dropdown = false,
  href,
  label,
  open = false,
  active,
  disabled,
  hovered,
  focused,
  placement = "bottom-start",
  fullWidth,
  mega,
  viewport,
  accent,
  accentColor,
  class: className,
  id,
  title,
  "aria-label": ariaLabel,
  ...rest
} = Astro.props as SpNavItemProps;

const navLinkClasses = getNavLinkClasses(omitUndefined({ active, disabled, hovered, focused }));
const finalNavLinkClass = [navLinkClasses, className].filter(Boolean).join(" ");
const wrapperClasses = getDropdownClasses(omitUndefined({ fullWidth, mega, viewport }));
const menuClasses = getDropdownMenuClasses(omitUndefined({ open, placement, mega, viewport, accent, accentColor }));
---

{
  dropdown ? (
    <div class={wrapperClasses} id={id} title={title}>
      <button
        type="button"
        class={finalNavLinkClass}
        data-sp-nav-item-trigger
        disabled={disabled ? true : undefined}
        aria-haspopup="true"
        aria-expanded={open ? "true" : "false"}
        aria-label={ariaLabel ?? label}
        {...rest}
      >
        <slot name="trigger">{label}</slot>
      </button>
      <div class={menuClasses} data-sp-nav-item-menu>
        <slot />
      </div>
    </div>
  ) : (
    <a
      href={disabled ? undefined : href}
      class={finalNavLinkClass}
      id={id}
      title={title}
      aria-label={ariaLabel}
      aria-current={active ? "page" : undefined}
      aria-disabled={disabled ? "true" : undefined}
      tabindex={disabled ? -1 : undefined}
      {...rest}
    >
      <slot>{label}</slot>
    </a>
  )
}
