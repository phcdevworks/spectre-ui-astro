---
import type { HTMLAttributes } from "astro/types";
import type { TooltipRecipeOptions } from "@phcdevworks/spectre-ui";
import { getTooltipClasses } from "@phcdevworks/spectre-ui";
import { omitUndefined } from "./sp-recipe-options.shared";

type SpTooltipElement = "div" | "span";

interface SpTooltipProps extends TooltipRecipeOptions {
  as?: SpTooltipElement;
  class?: string;
  id?: string;
  role?: HTMLAttributes<"div">["role"];

  [key: string]: unknown;
}

const {
  placement,
  visible,
  accent,
  accentColor,
  as: Tag = "div",
  class: className,
  id,
  role = "tooltip",
  ...rest
} = Astro.props as SpTooltipProps;

const classes = getTooltipClasses(omitUndefined({ placement, visible, accent, accentColor }));
const finalClass = [classes, className].filter(Boolean).join(" ");
---

<Tag class={finalClass} id={id} role={role} {...rest}>
  <slot />
</Tag>
