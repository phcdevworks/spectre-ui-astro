  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && npm run build:types && node --experimental-strip-types scripts/copy-components.ts && node --experimental-strip-types scripts/validate-package-contract.ts && npm run validate:readme && npm run validate:changelog",
    "build:types": "tsc --project tsconfig.build.json",
    "check": "npm run ci:verify && npm run check:ecosystem",
    "ci:verify": "npm run lint && npm run build && npm run typecheck && npm test",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && astro check",
    "release:propose": "node --experimental-strip-types scripts/propose-version.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "prepack": "npm run build",
    "validate:readme": "node --experimental-strip-types scripts/validate-readme-contract.ts",
    "validate:changelog": "node --experimental-strip-types scripts/validate-changelog-contract.ts",
    "check:version-sync": "npm run validate:readme",
    "check:ecosystem": "spectre-manifest-validate spectre.manifest.json && spectre-manifest-check spectre.manifest.json ."
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "peerDependencies": {
    "@phcdevworks/spectre-tokens": "^4.11.0",
    "@phcdevworks/spectre-ui": "^5.3.0",
    "astro": "^7.0.0",
    "typescript": "^5.0 || ^6.0 || ^7.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@phcdevworks/spectre-manifest": "^1.2.0",
    "@phcdevworks/spectre-tokens": "^4.11.0",
    "@phcdevworks/spectre-ui": "^5.3.0",
    "@types/node": "^26.6.3",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "astro": "^7.3.5",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true
  }
}
