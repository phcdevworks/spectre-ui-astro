    "./components/SpPagination.astro": "./dist/components/SpPagination.astro",
    "./components/SpPopover.astro": "./dist/components/SpPopover.astro",
    "./components/SpPricingCard.astro": "./dist/components/SpPricingCard.astro",
    "./components/SpProgress.astro": "./dist/components/SpProgress.astro",
    "./components/SpProse.astro": "./dist/components/SpProse.astro",
    "./components/SpRadio.astro": "./dist/components/SpRadio.astro",
    "./components/SpRange.astro": "./dist/components/SpRange.astro",
    "./components/SpRating.astro": "./dist/components/SpRating.astro",
    "./components/SpSection.astro": "./dist/components/SpSection.astro",
    "./components/SpSelect.astro": "./dist/components/SpSelect.astro",
    "./components/SpSidebar.astro": "./dist/components/SpSidebar.astro",
    "./components/SpSidebarGroup.astro": "./dist/components/SpSidebarGroup.astro",
