    "./components/SpDropdownDivider.astro": "./dist/components/SpDropdownDivider.astro",
    "./components/SpDropdownHeader.astro": "./dist/components/SpDropdownHeader.astro",
    "./components/SpDropdownItem.astro": "./dist/components/SpDropdownItem.astro",
    "./components/SpDropdownMenu.astro": "./dist/components/SpDropdownMenu.astro",
    "./components/SpExternalAuthButton.astro": "./dist/components/SpExternalAuthButton.astro",
    "./components/SpFieldset.astro": "./dist/components/SpFieldset.astro",
    "./components/SpFileInput.astro": "./dist/components/SpFileInput.astro",
    "./components/SpFooter.astro": "./dist/components/SpFooter.astro",
    "./components/SpFooterChip.astro": "./dist/components/SpFooterChip.astro",
    "./components/SpFooterDivider.astro": "./dist/components/SpFooterDivider.astro",
    "./components/SpFooterHeading.astro": "./dist/components/SpFooterHeading.astro",
    "./components/SpFooterLink.astro": "./dist/components/SpFooterLink.astro",
    "./components/SpFooterLinks.astro": "./dist/components/SpFooterLinks.astro",
    "./components/SpFooterText.astro": "./dist/components/SpFooterText.astro",
    "./components/SpGrid.astro": "./dist/components/SpGrid.astro",
    "./components/SpHeading.astro": "./dist/components/SpHeading.astro",
    "./components/SpIconBox.astro": "./dist/components/SpIconBox.astro",
    "./components/SpInput.astro": "./dist/components/SpInput.astro",
    "./components/SpInputGroup.astro": "./dist/components/SpInputGroup.astro",
    "./components/SpInputGroupAddon.astro": "./dist/components/SpInputGroupAddon.astro",
    "./components/SpLabel.astro": "./dist/components/SpLabel.astro",
    "./components/SpLead.astro": "./dist/components/SpLead.astro",
